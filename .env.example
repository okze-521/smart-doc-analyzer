# Smart Doc Analyzer 配置文件
# 复制此文件为 .env：  cp .env.example .env
# Docker 部署时可通过 docker-compose.yml 的 environment 段覆盖

# ── 应用 ──────────────────────────────
APP_NAME=Smart Doc Analyzer
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# ── LLM 后端（二选一） ────────────────
# ollama | deepseek
LLM_PROVIDER=ollama

# Ollama 本地（台式机 RTX 5090D 跑 qwen3.6:35b）
OLLAMA_HOST=http://192.168.3.200:11434
OLLAMA_MODEL=qwen3.6:35b-a3b-q4_K_M

# DeepSeek 云端兜底（需要 API Key）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# ── Embedding 模型 ────────────────────
# 本示例使用本地 BGE-small（512维，95MB）
# 如需切换 BGE-M3（1024维，2GB）：
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_DIM=1024
EMBEDDING_MODEL=/app/models/bge-small
EMBEDDING_DIM=512

# ── Reranker 精排（可选） ───────────────
# 设置模型路径以启用二次排序（提高 RAG 精度约 15%）
# 不设则仅用向量相似度
RERANKER_MODEL=/app/models/bge-reranker-v2-m3

# ── Qdrant 向量库 ────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=smart_docs

# ── 数据库 ────────────────────────────
DATABASE_URL=sqlite:///./data/smart_doc.db

# ── 安全 ──────────────────────────────
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ── HuggingFace 镜像（国内加速） ──────
# HF_ENDPOINT=https://hf-mirror.com
