# Smart Doc Analyzer 环境变量（复制为 .env 后修改）
APP_NAME="Smart Doc Analyzer"
DEBUG=true
SECRET_KEY="change-me-to-random-string"

# SQLite（开发环境）
DATABASE_URL="sqlite:///./data/smart_doc.db"

# Qdrant 向量库（复用现有容器）
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="smart_docs"

# Ollama LLM（台式机 192.168.3.200）
OLLAMA_HOST="http://192.168.3.200:11434"
OLLAMA_MODEL="qwen3.6:35b-a3b"

# Embedding 模型（笔记本 CPU）
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=1024
HF_ENDPOINT="https://hf-mirror.com"

# 文件上传
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# 文本切片
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3
